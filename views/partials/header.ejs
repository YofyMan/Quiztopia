<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Generate personalized quizzes with AI and track your scores.">
  <title><%= title %> | Quiztopia</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <script src="/script.js" defer></script>
</head>
<body>
<header class="site-header">
  <nav class="nav container" aria-label="Main navigation">
    <a class="brand" href="<%= currentUser ? '/dashboard' : '/' %>">
      <span class="brand-mark">Q</span>
      <span>Quiztopia</span>
    </a>
    <button class="menu-button" type="button" aria-label="Toggle navigation" aria-expanded="false">☰</button>
    <div class="nav-links">
      <% if (currentUser) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/history">History</a>
        <span class="user-chip"><%= currentUser.username %></span>
        <form action="/logout" method="POST">
          <button class="button button-ghost button-small" type="submit">Log out</button>
        </form>
      <% } else { %>
        <a href="/login">Log in</a>
        <a class="button button-primary button-small" href="/signup">Get started</a>
      <% } %>
    </div>
  </nav>
</header>
<main>
  <% if (message) { %>
    <div class="container alert alert-<%= message.type %>" role="alert"><%= message.text %></div>
  <% } %>
